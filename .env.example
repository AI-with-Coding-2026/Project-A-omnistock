DB_NAME=omnistock
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_HOST=127.0.0.1
DB_PORT=3306
# Email — defaults to console backend for local dev.
# For production (Azure App Service), override these via App Settings:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@omnistock.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True